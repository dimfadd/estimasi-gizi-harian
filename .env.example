# ---- wajib ----
# Database Postgres. Di Vercel: Storage → Neon → Connect (terisi otomatis).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Kunci acak untuk sesi login. Buat dengan: npx auth secret  atau  openssl rand -base64 32
AUTH_SECRET=

# Login Google (Google Cloud Console → Credentials → OAuth client ID, tipe Web application)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- opsional ----
# Email yang boleh membuka /admin (pisahkan dengan koma)
ADMIN_EMAILS=

# Email kontak yang ditampilkan di halaman /privasi
NEXT_PUBLIC_CONTACT_EMAIL=

# Penyimpanan foto sampel beta. Di Vercel: Storage → Blob → Connect (terisi otomatis).
# Tanpa ini, tombol "kirim foto piring" disembunyikan.
BLOB_READ_WRITE_TOKEN=

# ---- Pro ----
# Kunci API Claude untuk fitur "catat dari foto" (console.anthropic.com → API Keys).
# Tanpa ini, tombol foto disembunyikan untuk pengguna Pro.
ANTHROPIC_API_KEY=

# Model untuk membaca foto. Default claude-opus-5-5 (paling teliti).
# claude-haiku-5-5 jauh lebih murah; bandingkan akurasinya di /admin sebelum mengganti.
PHOTO_MODEL=

# Email yang otomatis Pro (pisahkan dengan koma), mis. untuk penguji. Admin selalu Pro.
PRO_EMAILS=

# ---- hanya untuk uji di komputer sendiri, JANGAN di Vercel ----
# Menampilkan login uji dengan email @dev.local. Otomatis mati di Vercel.
# DEV_LOGIN=1
